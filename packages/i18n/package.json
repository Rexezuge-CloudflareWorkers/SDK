{
  "name": "@rexezuge/i18n",
  "version": "1.0.3",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rexezuge-CloudflareWorkers/SDK.git",
    "directory": "packages/i18n"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "description": "Backend string bundle with twelve locales and Accept-Language-aware lookup."
}
