{
  "name": "@rexezuge/identity",
  "version": "1.0.8",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rexezuge-CloudflareWorkers/SDK.git",
    "directory": "packages/identity"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@rexezuge/d1": "workspace:*",
    "@rexezuge/errors": "workspace:*",
    "@rexezuge/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "description": "Account layer with address resolution, user DAOs, and canonical identity migrations."
}
