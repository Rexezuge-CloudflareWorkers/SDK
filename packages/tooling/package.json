{
  "name": "@rexezuge/tooling",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@rexezuge/shared": "workspace:*"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.9.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "jsonc-parser": "3.3.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
